        { "type": "color", "id": "bg_color", "label": "Background", "default": "#FFFFFF" },
        { "type": "color", "id": "border_color", "label": "Border Color", "default": "#8588B0" },
        { "type": "color", "id": "text_color", "label": "Text Color", "default": "#151515" },
        { "type": "checkbox", "id": "show_table", "label": "Show Counter Table", "default": true },
