<style>
  .sidebar-left {
    position: relative;
    padding: 12px 0;
    min-height: 200px;
  }
  .sidebar-nav{
    border: 1.13px solid #8588B0;
  }
  .sidebar-nav h3{
    background:#06149B;
    color:#fff;
    font-weight: 500;
    font-size: 24px;
    line-height: 40px;
    letter-spacing: 0%;
    text-align: center;
    text-transform: uppercase;
   }
   .sidebar-nav ul li a{
    color: #06149B;
    font-weight: 500;
    font-size: 20px;
    line-height: 100%;
    letter-spacing: 0%;
    text-decoration: underline;
    }
    .sidebar-nav ul li::marker{
        font-size:28px;
        color: #EA080C;
        line-height: normal;
    }
    .sidebar-block{
        margin-bottom:10px;
    }
    .sidebar-block:last-child { margin-bottom: 0; }
  @media (max-width: 768px) {
    .sidebar-left { display: none; }
  }
  /* Sidebar tidak memakai grid internal section halaman */
#shopify-section-{{ section.id }} {
  display: block;
  grid-template-columns: none;
  width: 100%;
  min-width: 0;
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

#shopify-section-{{ section.id }} > .sidebar-left {
  width: 100% !important;
  max-width: 100%;
  min-width: 0;
  box-sizing: border-box;
}

@media (max-width: 768px) {
  #shopify-section-{{ section.id }} {
    display: none;
  }
}

</style>

<div class="sidebar-left" style="width: {{ section.settings.sidebar_width }}px; background: {{ section.settings.bg_color }};">
  {% for block in section.blocks %}
    <div class="sidebar-block" {{ block.shopify_attributes }}>
      {% case block.type %}
        {% when 'nav_links' %}
          <nav class="sidebar-nav">
            <h3>{{ block.settings.title }}</h3>
            <ul>
              {% assign links = linklists[block.settings.menu] %}
              {% for link in links.links %}
                <li><a href="{{ link.url }}">{{ link.title }}</a></li>
              {% endfor %}
            </ul>
          </nav>
        {% when 'member_login' %}
            {% render 'sidebar-login', block: block %}
        
        {% when 'newsletter' %}
          {% render 'sidebar-newsletter', block: block %}

        {% when 'payment_method' %}
          {% render 'sidebar-payment', block: block %}

        {% when 'store_info' %}
          {% render 'sidebar-store-info', block: block %}
        
        {% when 'visitor_counter' %}
          {% render 'sidebar-counter', block: block %}

        {% when '@app' %}
          {% render block %}
      {% endcase %}
    </div>
  {% endfor %}
</div>

{% schema %}
{
