            { "type": "color", "id": "login_btn_bg", "label": "Login Button Background", "default": "#06149B" },
            { "type": "color", "id": "login_btn_text", "label": "Login Button Text", "default": "#FFFFFF" },
            { "type": "color", "id": "reset_btn_bg", "label": "Reset Button Background", "default": "#EA080C" },
