        { "type": "text", "id": "pm_label_8", "label": "Label 8" },
        { "type": "image_picker", "id": "pm_image_9", "label": "Logo 9" },
        { "type": "text", "id": "pm_label_9", "label": "Label 9" },
        { "type": "image_picker", "id": "pm_image_10", "label": "Logo 10" },
        { "type": "text", "id": "pm_label_10", "label": "Label 10" }
