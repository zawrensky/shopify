        { "type": "color", "id": "header_bg", "label": "Header Background", "default": "#06149B" },
        { "type": "color", "id": "header_text", "label": "Header Text", "default": "#FFFFFF" },
        { "type": "color", "id": "bg_color", "label": "Background", "default": "#FFFFFF" },
        { "type": "color", "id": "border_color", "label": "Border Color", "default": "#8588B0" },
