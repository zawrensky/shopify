        { "type": "header", "content": "Payment Logos" },
        { "type": "paragraph", "content": "Upload logo atau isi label teks (contoh: COD). Kosongkan jika tidak dipakai." },
        { "type": "image_picker", "id": "pm_image_1", "label": "Logo 1" },
