{% doc %}
  @prompt
    Buat blok tag artikel blog untuk ditempatkan di akhir konten artikel pada template Blog post. Ambil tag secara dinamis dari artikel yang sedang dibuka, jangan gunakan tag contoh atau daftar hardcoded.
    
    Setiap tag harus berupa tautan ke halaman blog induk yang difilter berdasarkan tag tersebut, menggunakan alamat blog dan format tag yang benar. Jika artikel tidak memiliki tag, sembunyikan seluruh blok termasuk label dan jaraknya.
    
    Tampilkan label “Topik:” diikuti tag berbentuk chip persegi dengan sudut tegas. Gaya sesuai Strade & The Popo: latar putih, teks dan border navy, aksen merah saat hover atau fokus, tipografi retro monospace.
    
    Tata letak horizontal yang membungkus ke baris berikutnya, responsif tanpa overflow di ponsel. Gunakan tautan yang aksesibel melalui keyboard dengan indikator fokus jelas.
    
    Sediakan pengaturan Theme Editor untuk label, warna teks/latar/border/hover, ukuran teks, jarak antar-tag, padding, dan alignment. Tag dan tautan harus selalu mengikuti artikel aktif, bukan artikel tertentu. Jangan mengubah isi artikel atau elemen tema lain.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}
{% assign current_article = article %}
{% if current_article != blank and current_article.tags.size > 0 %}
  {% style %}
    .ai-article-tags-{{ ai_gen_id }} {
      display: block;
      box-sizing: border-box;
      width: {{ block.settings.desktop_width_percent }}%;
      max-width: 100%;
      padding: {{ block.settings.padding }}px;
      color: {{ block.settings.text_color }};
      background: {{ block.settings.background_color }};
      font-family: 'Anonymous Pro', 'Courier New', monospace;
      font-size: {{ block.settings.text_size }}px;
      text-align: {{ block.settings.alignment }};
    }
    .ai-article-tags-{{ ai_gen_id }}__row {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: {% if block.settings.alignment == 'center' %}center{% elsif block.settings.alignment == 'right' %}flex-end{% else %}flex-start{% endif %};
      gap: {{ block.settings.tag_gap }}px;
      min-width: 0;
    }
    .ai-article-tags-{{ ai_gen_id }}__label {
      flex: 0 0 auto;
      color: {{ block.settings.text_color }};
    }
    .ai-article-tags-{{ ai_gen_id }}__link {
      display: inline-block;
      max-width: 100%;
      overflow-wrap: anywhere;
      padding: {{ block.settings.chip_padding }}px;
      border: 1px solid {{ block.settings.border_color }};
      border-radius: 0;
      color: {{ block.settings.text_color }};
      background: {{ block.settings.background_color }};
      text-decoration: none;
      line-height: 1.3;
    }
    .ai-article-tags-{{ ai_gen_id }}__link:hover,
    .ai-article-tags-{{ ai_gen_id }}__link:focus-visible {
      color: {{ block.settings.hover_text_color }};
      border-color: {{ block.settings.hover_color }};
      background: {{ block.settings.hover_background_color }};
    }
    .ai-article-tags-{{ ai_gen_id }}__link:focus-visible {
      outline: 2px solid {{ block.settings.hover_color }};
      outline-offset: 3px;
    }
    @media screen and (max-width: 749px) {
      .ai-article-tags-{{ ai_gen_id }} { width: 100%; }
    }
  {% endstyle %}

  <div class="ai-article-tags-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
    <div class="ai-article-tags-{{ ai_gen_id }}__row" aria-label="{{ block.settings.label | escape }}">
      <span class="ai-article-tags-{{ ai_gen_id }}__label">{{ block.settings.label | escape }}</span>
      {% for tag in current_article.tags %}
        <a class="ai-article-tags-{{ ai_gen_id }}__link" href="{{ blog.url }}/tagged/{{ tag | handleize }}">{{ tag | escape }}</a>
      {% endfor %}
    </div>
  </div>
{% endif %}

{% schema %}
{
  "name": "Tag artikel blog",
  "settings": [
    { "type": "text", "id": "label", "label": "Label", "default": "Topik:" },
    { "type": "range", "id": "desktop_width_percent", "label": "Lebar desktop", "min": 50, "max": 100, "step": 5, "unit": "%", "default": 100 },
    { "type": "color", "id": "text_color", "label": "Warna teks", "default": "#06149B" },
    { "type": "color", "id": "background_color", "label": "Latar", "default": "#FFFFFF" },
    { "type": "color", "id": "border_color", "label": "Warna border", "default": "#06149B" },
    { "type": "color", "id": "hover_color", "label": "Aksen hover", "default": "#EA080C" },
    { "type": "color", "id": "hover_text_color", "label": "Teks saat hover", "default": "#06149B" },
    { "type": "color", "id": "hover_background_color", "label": "Latar saat hover", "default": "#FFFFFF" },
    { "type": "range", "id": "text_size", "label": "Ukuran teks", "min": 10, "max": 24, "step": 1, "unit": "px", "default": 14 },
    { "type": "range", "id": "tag_gap", "label": "Jarak antar-tag", "min": 2, "max": 24, "step": 2, "unit": "px", "default": 8 },
    { "type": "range", "id": "padding", "label": "Jarak luar", "min": 0, "max": 40, "step": 2, "unit": "px", "default": 0 },
    { "type": "range", "id": "chip_padding", "label": "Padding chip", "min": 2, "max": 20, "step": 2, "unit": "px", "default": 6 },
    { "type": "select", "id": "alignment", "label": "Perataan", "options": [{ "value": "left", "label": "Kiri" }, { "value": "center", "label": "Tengah" }, { "value": "right", "label": "Kanan" }], "default": "left" }
  ],
  "presets": [{ "name": "Tag artikel blog" }],
  "tag": null,
  "class": "article-tag-block"
}
{% endschema %}