{% doc %}
  @prompt
    Create a flexible custom section that works on all pages 
    (homepage, product, collection, etc). Requirements:
    
    - Layout toggle: full-width or contained/centered with max-width setting
    - Section header: optional heading text, subheading text, 
      heading alignment (left/center/right)
    - Background settings: background color picker, background image 
      upload with overlay opacity
    - Spacing controls: padding top/bottom and left/right settings 
      (range sliders in px)
    - Color scheme selector
    - Accepts ALL available theme blocks including: text, image, button, 
      video, product description, rich text, collapsible row, 
      icon with text, etc
    - Each block should have its own settings (color, alignment, spacing)
    - Clean premium aesthetic matching a cycling apparel brand
    , add background for section header, add space content
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}
{% style %}
  .ai-flex-section-{{ ai_gen_id }}{border:1px #8588B0 solid;display:block;width:100%;background-color:{{ block.settings.background_color }};color:{{ block.settings.text_color }};position:relative;isolation:isolate}
  .ai-flex-section-{{ ai_gen_id }}::before{content:'';position:absolute;inset:0;z-index:-1;background-image:{% if block.settings.background_image != blank %}linear-gradient(rgba(0,0,0,{{ block.settings.overlay_opacity | divided_by:100.0 }}),rgba(0,0,0,{{ block.settings.overlay_opacity | divided_by:100.0 }})),url('{{ block.settings.background_image | image_url: width: 2400 }}'){% else %}none{% endif %};background-size:cover;background-position:center}
  .ai-flex-section__inner-{{ ai_gen_id }}{width:100%;max-width:{% if block.settings.layout == 'contained' %}{{ block.settings.max_width }}px{% else %}none{% endif %};margin-inline:auto;padding:{{ block.settings.padding_top }}px {{ block.settings.padding_horizontal }}px {{ block.settings.padding_bottom }}px}
  .ai-flex-section__header-{{ ai_gen_id }}{margin:0 0 {{ block.settings.header_content_gap }}px;padding:{{ block.settings.header_padding_vertical }}px {{ block.settings.header_padding_horizontal }}px;text-align:{{ block.settings.heading_alignment }};background-color:{{ block.settings.header_background_color }};{% if block.settings.header_background_image != blank %}background-image:linear-gradient(rgba(0,0,0,{{ block.settings.header_overlay_opacity | divided_by:100.0 }}),rgba(0,0,0,{{ block.settings.header_overlay_opacity | divided_by:100.0 }})),url('{{ block.settings.header_background_image | image_url: width: 2000 }}');background-size:cover;background-position:center;{% endif %}color:{{ block.settings.header_text_color }};}
  .ai-flex-section__heading-{{ ai_gen_id }}{margin:0 0 10px;color:inherit;font-family: "ChiKareGo2";
    font-weight: 500;
    font-size: 24px;
    line-height: 40px;
    letter-spacing: 0%;
  }
  .ai-flex-section__subheading-{{ ai_gen_id }}{margin:0;color:inherit;opacity:.82}
  .ai-flex-section__content-{{ ai_gen_id }}{width:100%;padding-block:{{ block.settings.content_padding_vertical }}px;padding-inline:{{ block.settings.content_padding_horizontal }}px}
  .ai-flex-section__empty-{{ ai_gen_id }}{padding:24px;border:1px dashed currentColor;opacity:.75;text-align:center}
  @media(max-width:749px){.ai-flex-section__inner-{{ ai_gen_id }}{padding-left:min({{ block.settings.padding_horizontal }}px,6vw);padding-right:min({{ block.settings.padding_horizontal }}px,6vw)}.ai-flex-section__content-{{ ai_gen_id }}{padding-inline:min({{ block.settings.content_padding_horizontal }}px,4vw)}}
{% endstyle %}
<div class="ai-flex-section-{{ ai_gen_id }} color-{{ block.settings.color_scheme }}" style="width:{{ block.settings.desktop_width_percent }}%;" {{ block.shopify_attributes }}><div class="ai-flex-section__inner-{{ ai_gen_id }}">{% if block.settings.heading != blank or block.settings.subheading != blank %}<header class="ai-flex-section__header-{{ ai_gen_id }}">{% if block.settings.heading != blank %}<h2 class="ai-flex-section__heading-{{ ai_gen_id }}">{{ block.settings.heading | escape }}</h2>{% endif %}{% if block.settings.subheading != blank %}<p class="ai-flex-section__subheading-{{ ai_gen_id }}">{{ block.settings.subheading | escape }}</p>{% endif %}</header>{% endif %}<div class="ai-flex-section__content-{{ ai_gen_id }}">{% if block.settings.body_content != blank %}{{ block.settings.body_content }}{% else %}<div class="ai-flex-section__empty-{{ ai_gen_id }}">Add content in the rich text field to build this panel.</div>{% endif %}</div></div></div>
{% schema %}
{"name":"Flexible content panel","settings":[{"type":"header","content":"Layout"},{"type":"select","id":"layout","label":"Width layout","options":[{"value":"full","label":"Full width"},{"value":"contained","label":"Contained"}],"default":"contained"},{"type":"range","id":"max_width","label":"Maximum width","min":600,"max":1800,"step":50,"unit":"px","default":1200},{"type":"range","id":"desktop_width_percent","label":"Desktop width","min":50,"max":100,"step":5,"unit":"%","default":100},{"type":"select","id":"color_scheme","label":"Color scheme","options":[{"value":"scheme-1","label":"Scheme 1"},{"value":"scheme-2","label":"Scheme 2"},{"value":"scheme-3","label":"Scheme 3"},{"value":"scheme-4","label":"Scheme 4"},{"value":"scheme-5","label":"Scheme 5"}],"default":"scheme-1"},{"type":"header","content":"Section header"},{"type":"text","id":"heading","label":"Heading","default":"Built for the ride"},{"type":"text","id":"subheading","label":"Subheading","default":"Performance details for every kilometer."},{"type":"select","id":"heading_alignment","label":"Alignment","options":[{"value":"left","label":"Left"},{"value":"center","label":"Center"},{"value":"right","label":"Right"}],"default":"left"},{"type":"color","id":"header_background_color","label":"Header background","default":"#06149B"},{"type":"color","id":"header_text_color","label":"Header text","default":"#FFFFFF"},{"type":"image_picker","id":"header_background_image","label":"Header background image"},{"type":"range","id":"header_overlay_opacity","label":"Header image overlay","min":0,"max":90,"step":5,"unit":"%","default":20},{"type":"range","id":"header_padding_vertical","label":"Header vertical padding","min":0,"max":80,"step":4,"unit":"px","default":24},{"type":"range","id":"header_padding_horizontal","label":"Header side padding","min":0,"max":80,"step":4,"unit":"px","default":24},{"type":"range","id":"header_content_gap","label":"Space below header","min":0,"max":80,"step":4,"unit":"px","default":32},{"type":"header","content":"Background"},{"type":"color","id":"background_color","label":"Background","default":"#F5F6F8"},{"type":"color","id":"text_color","label":"Text","default":"#151515"},{"type":"image_picker","id":"background_image","label":"Background image"},{"type":"range","id":"overlay_opacity","label":"Image overlay","min":0,"max":90,"step":5,"unit":"%","default":20},{"type":"richtext","id":"body_content","label":"Content","default":"<p>Add your section content here. You can include formatted text and links.</p>"},{"type":"header","content":"Content spacing"},{"type":"range","id":"content_padding_vertical","label":"Content vertical padding","min":0,"max":80,"step":4,"unit":"px","default":16},{"type":"range","id":"content_padding_horizontal","label":"Content side padding","min":0,"max":80,"step":4,"unit":"px","default":0},{"type":"header","content":"Section spacing"},{"type":"range","id":"padding_top","label":"Top padding","min":0,"max":120,"step":4,"unit":"px","default":48},{"type":"range","id":"padding_bottom","label":"Bottom padding","min":0,"max":120,"step":4,"unit":"px","default":48},{"type":"range","id":"padding_horizontal","label":"Side padding","min":0,"max":80,"step":4,"unit":"px","default":24}],"presets":[{"name":"Flexible content panel"}],"tag":null,"class":"flexible-content-panel"}
{% endschema %}