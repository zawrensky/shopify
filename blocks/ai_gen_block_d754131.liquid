{% doc %}
  @prompt
    Create a pre-header block that mimics a classic cycling/sports website style with three columns: left side has a bold logo text with a brand name in large blue bold italic font with a subtitle underneath (e.g. "& THE Popo!"), center has a cycling/bicycle illustration image (image picker) with bold promotional text lines in blue and red stacked vertically (e.g. "RACE-READY", "BUILT FOR SPEED", "LIVE TO RIDE!") with customizable colors, and right side has a search bar with a label "Search Product:" above it and a "GO!" submit button in blue. The overall background should be white, text compact and bold, layout dense and information-rich similar to a classic 2000s sports website header., Brand replace with image picker, promotion area and search area need closser
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}
{% style %}.ai-preheader-{{ ai_gen_id }}{display:block;width:{{ block.settings.desktop_width_percent }}%;max-width:100%;margin:0 auto;background:{{ block.settings.background_color }};color:{{ block.settings.text_color }};border-bottom:{{ block.settings.border_width }}px solid {{ block.settings.border_color }};}.ai-preheader-{{ ai_gen_id }}__inner{display:grid;grid-template-columns:minmax(150px,.9fr) minmax(240px,1.6fr) minmax(230px,1.1fr);align-items:center;min-height:112px;padding:14px 16px}.ai-preheader-{{ ai_gen_id }}__brand{min-width:0;border-right:1px solid {{ block.settings.border_color }};padding-right:12px}.ai-preheader-{{ ai_gen_id }}__brand-logo{display:block;width:100%;max-width:{{ block.settings.brand_logo_width }}px;height:auto;max-height:{{ block.settings.brand_logo_height }}px;object-fit:contain;object-position:left center}.ai-preheader-{{ ai_gen_id }}__brand-name{display:block;color:{{ block.settings.brand_color }};font-size:{{ block.settings.brand_size }}px;font-style:italic;font-weight:800;letter-spacing:-.04em;line-height:.9;overflow-wrap:anywhere}.ai-preheader-{{ ai_gen_id }}__brand-subtitle{display:block;margin-top:7px;color:{{ block.settings.text_color }};font-size:11px;font-weight:800;letter-spacing:.12em;line-height:1.1;text-transform:uppercase}.ai-preheader-{{ ai_gen_id }}__promo{display:flex;align-items:center;justify-content:center;gap:8px;min-width:0;padding:0 8px}.ai-preheader-{{ ai_gen_id }}__image,.ai-preheader-{{ ai_gen_id }}__image-placeholder{flex:0 0 82px;width:82px;height:70px;object-fit:contain}.ai-preheader-{{ ai_gen_id }}__image-placeholder{display:flex;align-items:center;justify-content:center;background:#f2f4f7;color:#68717c}.ai-preheader-{{ ai_gen_id }}__image-placeholder svg{width:100%;height:100%}.ai-preheader-{{ ai_gen_id }}__lines{display:flex;flex-direction:column;gap:1px;min-width:0;font-size:{{ block.settings.promo_size }}px;font-style:italic;font-weight:800;line-height:.95;text-transform:uppercase}.ai-preheader-{{ ai_gen_id }}__line--blue{color:{{ block.settings.promo_blue_color }}}.ai-preheader-{{ ai_gen_id }}__line--red{color:{{ block.settings.promo_red_color }}}.ai-preheader-{{ ai_gen_id }}__search{border-left:1px solid {{ block.settings.border_color }};padding-left:12px}.ai-preheader-{{ ai_gen_id }}__label{display:block;margin-bottom:6px;color:{{ block.settings.text_color }};font-size:11px;font-weight:800;letter-spacing:.08em;text-transform:uppercase}.ai-preheader-{{ ai_gen_id }}__form{display:flex;gap:4px}.ai-preheader-{{ ai_gen_id }}__input{min-width:0;flex:1 1 auto;min-height:34px;padding:7px 8px;border:1px solid {{ block.settings.input_border_color }};border-radius:2px;background:{{ block.settings.input_background }};color:{{ block.settings.text_color }};font:inherit;font-size:12px}.ai-preheader-{{ ai_gen_id }}__input:focus-visible,.ai-preheader-{{ ai_gen_id }}__button:focus-visible{outline:2px solid {{ block.settings.brand_color }};outline-offset:2px}.ai-preheader-{{ ai_gen_id }}__button{flex:0 0 auto;min-height:34px;padding:6px 12px;border:0;border-radius:2px;background:{{ block.settings.button_color }};color:{{ block.settings.button_text_color }};cursor:pointer;font:inherit;font-size:12px;font-weight:800;letter-spacing:.06em}@media screen and (max-width:749px){.ai-preheader-{{ ai_gen_id }}__inner{grid-template-columns:1fr 1fr;gap:12px;padding:14px}.ai-preheader-{{ ai_gen_id }}__brand{border-right:0;padding-right:0}.ai-preheader-{{ ai_gen_id }}__promo{justify-content:flex-end;padding:0}.ai-preheader-{{ ai_gen_id }}__search{grid-column:1/-1;border-top:1px solid {{ block.settings.border_color }};border-left:0;padding:12px 0 0}}{% endstyle %}
<div class="ai-preheader-{{ ai_gen_id }}" {{ block.shopify_attributes }}><div class="ai-preheader-{{ ai_gen_id }}__inner"><div class="ai-preheader-{{ ai_gen_id }}__brand">{% if block.settings.brand_image != blank %}<img class="ai-preheader-{{ ai_gen_id }}__brand-logo" src="{{ block.settings.brand_image | image_url: width: 600 }}" alt="{{ block.settings.brand_image.alt | default: block.settings.brand_name | escape }}" loading="lazy" width="600" height="200">{% else %}<span class="ai-preheader-{{ ai_gen_id }}__brand-name">{{ block.settings.brand_name | escape }}</span>{% endif %}<span class="ai-preheader-{{ ai_gen_id }}__brand-subtitle">{{ block.settings.brand_subtitle | escape }}</span></div><div class="ai-preheader-{{ ai_gen_id }}__promo">{% if block.settings.cycling_image != blank %}<img class="ai-preheader-{{ ai_gen_id }}__image" src="{{ block.settings.cycling_image | image_url: width: 240 }}" alt="{{ block.settings.cycling_image.alt | escape }}" loading="lazy" width="240" height="190">{% else %}<div class="ai-preheader-{{ ai_gen_id }}__image-placeholder">{{ 'image' | placeholder_svg_tag }}</div>{% endif %}<div class="ai-preheader-{{ ai_gen_id }}__lines"><span class="ai-preheader-{{ ai_gen_id }}__line--blue">{{ block.settings.promo_line_1 | escape }}</span><span class="ai-preheader-{{ ai_gen_id }}__line--red">{{ block.settings.promo_line_2 | escape }}</span><span class="ai-preheader-{{ ai_gen_id }}__line--blue">{{ block.settings.promo_line_3 | escape }}</span></div></div><div class="ai-preheader-{{ ai_gen_id }}__search"><span class="ai-preheader-{{ ai_gen_id }}__label">{{ block.settings.search_label | escape }}</span><form class="ai-preheader-{{ ai_gen_id }}__form" action="{{ routes.search_url }}" method="get" role="search"><label class="visually-hidden" for="ai-preheader-search-{{ ai_gen_id }}">{{ block.settings.search_label | escape }}</label><input id="ai-preheader-search-{{ ai_gen_id }}" class="ai-preheader-{{ ai_gen_id }}__input" type="search" name="q" placeholder="{{ block.settings.search_placeholder | escape }}" aria-label="{{ block.settings.search_label | escape }}"><button class="ai-preheader-{{ ai_gen_id }}__button" type="submit">{{ block.settings.button_label | escape }}</button></form></div></div></div>
{% schema %}{"name":"Cycling pre-header","settings":[{"type":"header","content":"Brand"},{"type":"image_picker","id":"brand_image","label":"Brand image"},{"type":"text","id":"brand_name","label":"Alt brand name","default":"POPO CYCLE"},{"type":"text","id":"brand_subtitle","label":"Subtitle","default":"& THE Popo!"},{"type":"range","id":"brand_size","label":"Brand size","min":20,"max":56,"step":2,"unit":"px","default":36},{"type":"range","id":"brand_logo_width","label":"Logo width","min":80,"max":400,"step":10,"unit":"px","default":220},{"type":"range","id":"brand_logo_height","label":"Logo height","min":30,"max":140,"step":10,"unit":"px","default":70},{"type":"header","content":"Promotion"},{"type":"image_picker","id":"cycling_image","label":"Cycling image"},{"type":"text","id":"promo_line_1","label":"Blue line","default":"RACE-READY"},{"type":"text","id":"promo_line_2","label":"Red line","default":"BUILT FOR SPEED"},{"type":"text","id":"promo_line_3","label":"Blue line 2","default":"LIVE TO RIDE!"},{"type":"range","id":"promo_size","label":"Promo size","min":14,"max":34,"step":2,"unit":"px","default":22},{"type":"header","content":"Search"},{"type":"text","id":"search_label","label":"Label","default":"Search Product:"},{"type":"text","id":"search_placeholder","label":"Placeholder","default":"Enter product name"},{"type":"text","id":"button_label","label":"Button label","default":"GO!"},{"type":"header","content":"Style"},{"type":"range","id":"desktop_width_percent","label":"Desktop width","min":50,"max":100,"step":5,"unit":"%","default":100},{"type":"font_picker","id":"heading_font","label":"Display font","default":"inter_n7"},{"type":"font_picker","id":"body_font","label":"Body font","default":"inter_n4"},{"type":"color","id":"background_color","label":"Background","default":"#FFFFFF"},{"type":"color","id":"text_color","label":"Text","default":"#111111"},{"type":"color","id":"brand_color","label":"Brand","default":"#0645AD"},{"type":"color","id":"promo_blue_color","label":"Promo blue","default":"#0645AD"},{"type":"color","id":"promo_red_color","label":"Promo red","default":"#C62828"},{"type":"color","id":"button_color","label":"Button","default":"#0645AD"},{"type":"color","id":"button_text_color","label":"Button text","default":"#FFFFFF"},{"type":"color","id":"input_background","label":"Input background","default":"#FFFFFF"},{"type":"color","id":"input_border_color","label":"Input border","default":"#333333"},{"type":"color","id":"border_color","label":"Divider","default":"#DFDFDF"},{"type":"range","id":"border_width","label":"Divider width","min":0,"max":4,"step":1,"unit":"px","default":1}],"presets":[{"name":"Cycling pre-header"}],"tag":null,"class":"classic-cycling-pre-header"}{% endschema %}