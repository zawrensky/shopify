{% doc %}
  @prompt
    Create a hero banner block with the following features based on a cycling/sports apparel style: A full-width banner with a background image (image picker setting). Settings include: adjustable banner height (small/medium/large/full screen options), overlay opacity slider. Text content settings: bold large heading/title (white text, italic, uppercase like "RACE-READY BUILT FOR SPEED"), subtitle text in red/accent color (like "NEW COLLECTION 2024"), and a description text field. Two CTA buttons side by side, each fully customizable: button label text, button URL link, button background color picker, button text color picker, button border color picker, button style toggle (solid or outline). Text is left-aligned overlaid on the image. The overall layout matches a sports banner with text and buttons in the lower-left area of the image. All settings should be editable in the Theme Editor block settings panel., add font/typography settings in text title,subtitle and text description, add border banner setting options
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}
{% style %}
.ai-hero-{{ ai_gen_id }}{display:block;position:relative;width:{{ block.settings.desktop_width_percent }}%;max-width:100%;height:{{ block.settings.banner_height }};min-height:320px;overflow:hidden;color:{{ block.settings.heading_color }};background:#202020;border-style:{{ block.settings.banner_border_style }};border-width:{{ block.settings.banner_border_width }}px;border-color:{{ block.settings.banner_border_color }};border-radius:{{ block.settings.banner_border_radius }}px;box-sizing:border-box}.ai-hero-{{ ai_gen_id }}__media,.ai-hero-{{ ai_gen_id }}__media img,.ai-hero-{{ ai_gen_id }}__placeholder{position:absolute;inset:0;width:100%;height:100%}.ai-hero-{{ ai_gen_id }}__media img{object-fit:cover}.ai-hero-{{ ai_gen_id }}__placeholder{display:flex;align-items:center;justify-content:center;background:#333}.ai-hero-{{ ai_gen_id }}__placeholder svg{width:100%;height:100%;max-width:520px;color:#777}.ai-hero-{{ ai_gen_id }}__overlay{position:absolute;inset:0;background:#000;opacity:{{ block.settings.overlay_opacity | divided_by: 100.0 }}}.ai-hero-{{ ai_gen_id }}__content{position:relative;z-index:1;display:flex;flex-direction:column;justify-content:flex-end;align-items:flex-start;width:100%;height:100%;max-width:550px;padding:clamp(28px,6vw,84px);box-sizing:border-box}.ai-hero-{{ ai_gen_id }}__eyebrow{margin:0 0 12px;color:{{ block.settings.subtitle_color }};font-family: "ChiKareGo2";font-style:italic;font-size:{{ block.settings.subtitle_size }}px;font-weight:{{ block.settings.subtitle_weight }};line-height:1.2;letter-spacing:.14em;text-transform:uppercase}.ai-hero-{{ ai_gen_id }}__heading{margin:0;color:{{ block.settings.heading_color }};font-size:clamp({{ block.settings.heading_size | times: 0.5 }}px,6vw,{{ block.settings.heading_size }}px);font-style:italic;font-weight:{{ block.settings.heading_weight }};line-height:.94;letter-spacing:-.03em;text-transform:uppercase}.ai-hero-{{ ai_gen_id }}__description{max-width:560px;margin:20px 0 0;color:{{ block.settings.description_color }};font-size:{{ block.settings.description_size }}px;font-weight:{{ block.settings.description_weight }};line-height:1.5}.ai-hero-{{ ai_gen_id }}__actions{display:flex;flex-wrap:wrap;gap:12px;margin-top:28px}.ai-hero-{{ ai_gen_id }}__button{display:inline-flex;align-items:center;justify-content:center;min-width:140px;padding:14px 22px;border:2px solid;border-radius:0;font-family: "ChiKareGo2";font-size:13px;font-weight:700;letter-spacing:.08em;line-height:1.2;text-align:center;text-transform:uppercase;text-decoration:none}.ai-hero-{{ ai_gen_id }}__button:focus-visible{outline:3px solid #fff;outline-offset:3px}.ai-hero-{{ ai_gen_id }}__button--one{background:{% if block.settings.button_one_style == 'outline' %}transparent{% else %}{{ block.settings.button_one_background }}{% endif %};color:{{ block.settings.button_one_text }};border-color:{{ block.settings.button_one_border }}}.ai-hero-{{ ai_gen_id }}__button--two{background:{% if block.settings.button_two_style == 'outline' %}transparent{% else %}{{ block.settings.button_two_background }}{% endif %};color:{{ block.settings.button_two_text }};border-color:{{ block.settings.button_two_border }}}@media screen and (max-width:749px){.ai-hero-{{ ai_gen_id }}{width:100%;min-height:420px}.ai-hero-{{ ai_gen_id }}__content{padding:28px 22px}.ai-hero-{{ ai_gen_id }}__actions{width:100%}.ai-hero-{{ ai_gen_id }}__button{flex:1 1 140px}}
{% endstyle %}
<div class="ai-hero-{{ ai_gen_id }}" {{ block.shopify_attributes }}><div class="ai-hero-{{ ai_gen_id }}__media">{% if block.settings.background_image != blank %}<img src="{{ block.settings.background_image | image_url: width: 2400 }}" alt="{{ block.settings.background_image.alt | escape }}" loading="lazy" width="{{ block.settings.background_image.width }}" height="{{ block.settings.background_image.height }}">{% else %}<div class="ai-hero-{{ ai_gen_id }}__placeholder">{{ 'hero-apparel-1' | placeholder_svg_tag }}</div>{% endif %}</div><div class="ai-hero-{{ ai_gen_id }}__overlay"></div><div class="ai-hero-{{ ai_gen_id }}__content">{% if block.settings.subtitle != blank %}<p class="ai-hero-{{ ai_gen_id }}__eyebrow">{{ block.settings.subtitle }}</p>{% endif %}{% if block.settings.heading != blank %}<h2 class="ai-hero-{{ ai_gen_id }}__heading">{{ block.settings.heading }}</h2>{% endif %}{% if block.settings.description != blank %}<div class="ai-hero-{{ ai_gen_id }}__description">{{ block.settings.description }}</div>{% endif %}<div class="ai-hero-{{ ai_gen_id }}__actions">{% if block.settings.button_one_label != blank %}<a class="ai-hero-{{ ai_gen_id }}__button ai-hero-{{ ai_gen_id }}__button--one" href="{{ block.settings.button_one_link }}">{{ block.settings.button_one_label }}</a>{% endif %}{% if block.settings.button_two_label != blank %}<a class="ai-hero-{{ ai_gen_id }}__button ai-hero-{{ ai_gen_id }}__button--two" href="{{ block.settings.button_two_link }}">{{ block.settings.button_two_label }}</a>{% endif %}</div></div></div>
{% schema %}{"name":"Sports hero banner","settings":[{"type":"header","content":"Banner"},{"type":"image_picker","id":"background_image","label":"Background image"},{"type":"select","id":"banner_height","label":"Banner height","options":[{"value":"380px","label":"Small"},{"value":"560px","label":"Medium"},{"value":"720px","label":"Large"},{"value":"100vh","label":"Full screen"}],"default":"380px"},{"type":"range","id":"overlay_opacity","label":"Overlay opacity","min":0,"max":100,"step":5,"unit":"%","default":45},{"type":"range","id":"desktop_width_percent","label":"Desktop width","min":50,"max":100,"step":5,"unit":"%","default":100},{"type":"select","id":"banner_border_style","label":"Border style","options":[{"value":"none","label":"None"},{"value":"solid","label":"Solid"},{"value":"dashed","label":"Dashed"}],"default":"none"},{"type":"range","id":"banner_border_width","label":"Border width","min":0,"max":12,"step":1,"unit":"px","default":0},{"type":"color","id":"banner_border_color","label":"Border color","default":"#FFFFFF"},{"type":"range","id":"banner_border_radius","label":"Corner radius","min":0,"max":40,"step":2,"unit":"px","default":0},{"type":"header","content":"Title typography"},{"type":"text","id":"heading","label":"Title","default":"Race-ready built for speed"},{"type":"font_picker","id":"heading_font","label":"Font","default":"sans-serif"},{"type":"range","id":"heading_size","label":"Size","min":1,"max":70,"step":1,"unit":"px","default":14},{"type":"select","id":"heading_weight","label":"Weight","options":[{"value":"600","label":"Semibold"},{"value":"700","label":"Bold"},{"value":"800","label":"Extra bold"}],"default":"800"},{"type":"color","id":"heading_color","label":"Color","default":"#FFFFFF"},{"type":"header","content":"Subtitle typography"},{"type":"text","id":"subtitle","label":"Subtitle","default":"New collection 2024"},{"type":"font_picker","id":"subtitle_font","label":"Font","default":"sans-serif"},{"type":"range","id":"subtitle_size","label":"Size","min":2,"max":72,"step":2,"unit":"px","default":14},{"type":"select","id":"subtitle_weight","label":"Weight","options":[{"value":"400","label":"Regular"},{"value":"600","label":"Semibold"},{"value":"700","label":"Bold"}],"default":"700"},{"type":"color","id":"subtitle_color","label":"Color","default":"#FF3B30"},{"type":"header","content":"Description typography"},{"type":"textarea","id":"description","label":"Description","default":"Performance apparel engineered for every ride."},{"type":"font_picker","id":"description_font","label":"Font","default":"sans-serif"},{"type":"range","id":"description_size","label":"Size","min":12,"max":28,"step":2,"unit":"px","default":16},{"type":"select","id":"description_weight","label":"Weight","options":[{"value":"400","label":"Regular"},{"value":"500","label":"Medium"},{"value":"600","label":"Semibold"}],"default":"400"},{"type":"color","id":"description_color","label":"Color","default":"#FFFFFF"},{"type":"header","content":"Button one"},{"type":"text","id":"button_one_label","label":"Label","default":"Shop collection"},{"type":"url","id":"button_one_link","label":"Link"},{"type":"select","id":"button_one_style","label":"Style","options":[{"value":"solid","label":"Solid"},{"value":"outline","label":"Outline"}],"default":"solid"},{"type":"color","id":"button_one_background","label":"Background","default":"#FF3B30"},{"type":"color","id":"button_one_text","label":"Text","default":"#FFFFFF"},{"type":"color","id":"button_one_border","label":"Border","default":"#FF3B30"},{"type":"header","content":"Button two"},{"type":"text","id":"button_two_label","label":"Label","default":"Explore gear"},{"type":"url","id":"button_two_link","label":"Link"},{"type":"select","id":"button_two_style","label":"Style","options":[{"value":"solid","label":"Solid"},{"value":"outline","label":"Outline"}],"default":"solid"},{"type":"color","id":"button_two_background","label":"Background","default":"#FFFFFF"},{"type":"color","id":"button_two_text","label":"Text","default":"#FFFFFF"},{"type":"color","id":"button_two_border","label":"Border","default":"#FFFFFF"}],"presets":[{"name":"Sports hero banner"}],"tag":null,"class":"sports-hero-banner"}{% endschema %}