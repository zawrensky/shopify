{% doc %}
  @prompt
    Create a top bar announcement block that mimics a classic website header bar with: a left-aligned welcome/store name message with bold highlighted text in a contrasting color, a centered promotional message (e.g. FREE SHIPPING WORLDWIDE) with an icon like a bicycle or delivery icon and bold highlighted text, and a right-aligned date and time display. The bar should have a light gray or white background with small compact text, and support customizable colors for the highlight/accent text. The overall style should be minimal and information-dense, similar to a classic website top info bar., welcome, free shipping, date time rata vertical, add space between welcome to and my store
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}
{% style %}
.ai-topbar-{{ ai_gen_id }}{display:block;width:{{ block.settings.desktop_width_percent }}%;max-width:100%;margin:0 auto;background:{{ block.settings.background_color }};color:{{ block.settings.text_color }};border-bottom:1px solid {{ block.settings.border_color }};}.ai-topbar-{{ ai_gen_id }}__inner{min-height:36px;padding:7px 18px;display:grid;grid-template-columns:1fr auto 1fr;align-items:center;gap:18px;font-size:{{ block.settings.text_size }}px;line-height:1.2;letter-spacing:.04em}.ai-topbar-{{ ai_gen_id }}__item{min-width:0;min-height:20px;display:flex;align-items:center;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.ai-topbar-{{ ai_gen_id }}__item--left{justify-content:flex-start;text-align:left;gap:6px}.ai-topbar-{{ ai_gen_id }}__item--center{justify-content:center;text-align:center}.ai-topbar-{{ ai_gen_id }}__item--right{justify-content:flex-end;text-align:right}.ai-topbar-{{ ai_gen_id }}__highlight{color:{{ block.settings.accent_color }};font-weight:700}.ai-topbar-{{ ai_gen_id }}__promotion{display:inline-flex;align-items:center;justify-content:center;gap:7px;font-weight:700}.ai-topbar-{{ ai_gen_id }}__icon{width:16px;height:16px;flex:0 0 16px;color:{{ block.settings.accent_color }}}.ai-topbar-{{ ai_gen_id }}__time{font-variant-numeric:tabular-nums}@media screen and (max-width:749px){.ai-topbar-{{ ai_gen_id }}__inner{grid-template-columns:1fr 1fr;gap:8px 12px;padding:7px 12px;font-size:{{ block.settings.mobile_text_size }}px}.ai-topbar-{{ ai_gen_id }}__item--center{grid-column:1 / -1;grid-row:1;order:-1}}
{% endstyle %}
<classic-topbar-{{ ai_gen_id }} class="ai-topbar-{{ ai_gen_id }}" data-timezone="{{ block.settings.timezone | escape }}" data-date-format="{{ block.settings.date_format | escape }}" {{ block.shopify_attributes }}><div class="ai-topbar-{{ ai_gen_id }}__inner"><div class="ai-topbar-{{ ai_gen_id }}__item ai-topbar-{{ ai_gen_id }}__item--left"><span>{{ block.settings.welcome_text }}</span><span class="ai-topbar-{{ ai_gen_id }}__highlight">{{ block.settings.store_name }}</span></div><div class="ai-topbar-{{ ai_gen_id }}__item ai-topbar-{{ ai_gen_id }}__item--center"><span class="ai-topbar-{{ ai_gen_id }}__promotion">

 {% if block.settings.shipping_icon != blank %}
  <img 
    class="ai-topbar-{{ ai_gen_id }}__icon"
    src="{{ block.settings.shipping_icon | image_url: width: 16 }}" 
    alt="{{ block.settings.shipping_icon.alt }}"
    width="16"
    height="16"
  >
{% endif %}

<span>{{ block.settings.promotion_text }} <span class="ai-topbar-{{ ai_gen_id }}__highlight">{{ block.settings.promotion_highlight }}</span></span></span></div><div class="ai-topbar-{{ ai_gen_id }}__item ai-topbar-{{ ai_gen_id }}__item--right ai-topbar-{{ ai_gen_id }}__time" aria-live="polite"><span data-date></span><span aria-hidden="true"> · </span><span data-time></span></div></div></classic-topbar-{{ ai_gen_id }}>
<script>(function(){class ClassicTopbar{{ ai_gen_id }} extends HTMLElement{connectedCallback(){this.dateElement=this.querySelector('[data-date]');this.timeElement=this.querySelector('[data-time]');this.timezone=this.dataset.timezone||'Asia/Jakarta';this.dateFormat=this.dataset.dateFormat||'DD/MM/YYYY';this.updateDateTime();this.timer=setInterval(()=>this.updateDateTime(),1000)}disconnectedCallback(){clearInterval(this.timer)}updateDateTime(){const n=new Date(),p=new Intl.DateTimeFormat('en-GB',{timeZone:this.timezone,day:'2-digit',month:'2-digit',year:'numeric'}).formatToParts(n).reduce((o,x)=>(o[x.type]=x.value,o),{});this.dateElement.textContent=this.dateFormat.replace('DD',p.day).replace('MM',p.month).replace('YYYY',p.year);this.timeElement.textContent=new Intl.DateTimeFormat('en-GB',{timeZone:this.timezone,hour:'2-digit',minute:'2-digit',second:'2-digit',hour12:false}).format(n)}}customElements.define('classic-topbar-{{ ai_gen_id }}',ClassicTopbar{{ ai_gen_id }})})();</script>
{% schema %}{"name":"Classic top bar","settings":[{"type":"header","content":"Content"},{"type":"text","id":"welcome_text","label":"Welcome text","default":"Welcome to"},{"type":"text","id":"store_name","label":"Store name","default":"My Store"},{"type":"text","id":"promotion_text","label":"Promotion text","default":"FREE SHIPPING"},{"type":"text","id":"promotion_highlight","label":"Promotion highlight","default":"WORLDWIDE"},{"type":"image_picker","id":"shipping_icon","label":"Shipping Icon"},{"type":"text","id":"timezone","label":"Time zone","default":"Asia/Jakarta"},{"type":"text","id":"date_format","label":"Date format","default":"DD/MM/YYYY"},{"type":"header","content":"Style"},{"type":"range","id":"desktop_width_percent","label":"Desktop width","min":50,"max":100,"step":5,"unit":"%","default":100},{"type":"range","id":"text_size","label":"Text size","min":10,"max":18,"step":1,"unit":"px","default":12},{"type":"range","id":"mobile_text_size","label":"Mobile text size","min":9,"max":16,"step":1,"unit":"px","default":10},{"type":"font_picker","id":"body_font","label":"Font","default":"inter_n4"},{"type":"color","id":"background_color","label":"Background","default":"#FFFFFF"},{"type":"color","id":"text_color","label":"Text","default":"#222222"},{"type":"color","id":"accent_color","label":"Accent text","default":"#B3261E"},{"type":"color","id":"border_color","label":"Border","default":"#DFDFDF"}],"presets":[{"name":"Classic top bar"}],"tag":null,"class":"classic-top-bar-block"}{% endschema %}