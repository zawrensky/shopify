{% doc %}
  @prompt
    Create an "Our Story" article block with a two-column layout: left side has a bold headline (2 lines supported), body text paragraphs, and right side has an image. Include a small navy header bar at the top spanning full width with editable title text (e.g. " OUR STORY "). Settings: header background color, header text color, headline text, headline color, body text (richtext), image picker, image position (left or right toggle), background color, text color. Clean readable typography matching cycling apparel brand aesthetic. Responsive: stack vertically on mobile with image below text.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-our-story-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    background: {{ block.settings.background_color }};
    color: {{ block.settings.text_color }};
    border: 1px #8588B0 solid;
  }

  .ai-our-story-{{ ai_gen_id }}__bar {
    width: 100%;
    box-sizing: border-box;
    padding: 12px 20px;
    background: {{ block.settings.header_background_color }};
    color: {{ block.settings.header_text_color }};
    font-family: 'ChiKareGo2';
    font-weight: 500;
    font-size: 24px;
    letter-spacing: 0;
    line-height: 1.3;
    text-transform: uppercase;
  }

  .ai-our-story-{{ ai_gen_id }}__layout {
    display: flex;
    align-items: stretch;
    flex-direction: {% if block.settings.image_position == 'left' %}row-reverse{% else %}row{% endif %};
    width: 100%;
    padding: {{ block.settings.block_padding }};
    gap: {{ block.settings.layout_gap }}px;
  }

  .ai-our-story-{{ ai_gen_id }}__copy,
  .ai-our-story-{{ ai_gen_id }}__media {
    box-sizing: border-box;
    min-width: 0;
  }

  .ai-our-story-{{ ai_gen_id }}__copy {
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    gap: {{ block.settings.layout_gap }}px;
    width: {{ block.settings.copy_width }}%;
  }

  .ai-our-story-{{ ai_gen_id }}__headline {
    color: {{ block.settings.headline_color }};
    font-family: 'ChiKareGo2';
    font-size: {{ block.settings.headline_size }}px;
    font-weight: 500;
    letter-spacing: 0;
    line-height: 100%;
    text-wrap: balance;
    text-transform: {{ block.settings.headline_style }};
    margin:0;
  }

  .ai-our-story-{{ ai_gen_id }}__body {
    font-size: {{ block.settings.body_size }}px;
    line-height: 1.75;
  }

  .ai-our-story-{{ ai_gen_id }}__body > *:first-child { margin-top: 0; }
  .ai-our-story-{{ ai_gen_id }}__body > *:last-child { margin-bottom: 0; }

  .ai-our-story-{{ ai_gen_id }}__media {
    position: relative;
    overflow: hidden;
    max-height: 284px;
    width: {{ block.settings.media_width }}%;
    padding: {{ block.settings.media_padding }}px;
  }

  .ai-our-story-{{ ai_gen_id }}__image,
  .ai-our-story-{{ ai_gen_id }}__placeholder svg {
    display: block;
    width: 100%;
    height: 100%;
    min-height: 280px;
    object-fit: cover;
  }

  .ai-our-story-{{ ai_gen_id }}__placeholder {
    position: relative;
    min-height: 360px;
    height: 100%;
  }

  .ai-our-story-{{ ai_gen_id }}__placeholder svg {
    color: #526071;
    background: #eef1f4;
  }

  .ai-our-story-{{ ai_gen_id }}__empty-state {
    position: absolute;
    right: 16px;
    bottom: 16px;
    left: 16px;
    color: #26364a;
    font-size: 13px;
    text-align: center;
  }

  .ai-our-story-{{ ai_gen_id }}__button{
    background: {{ block.settings.cta_background_color }};
    color: {{ block.settings.cta_text_color }};
    display: inline-block;
    font-family: 'ChiKareGo2';
    font-weight: 500;
    font-size: {{ block.settings.cta_size }}px;
    line-height: 23.63px;
    letter-spacing: 0%;
    text-align: center;
    padding: {{ block.settings.cta_padding }};
  }

  @media screen and (max-width: 749px) {
    .ai-our-story-{{ ai_gen_id }} { width: 100%; }
    .ai-our-story-{{ ai_gen_id }}__layout { flex-direction: column; }
    .ai-our-story-{{ ai_gen_id }}__copy,
    .ai-our-story-{{ ai_gen_id }}__media { width: 100%; }
    .ai-our-story-{{ ai_gen_id }}__copy { padding: 24px; }
    .ai-our-story-{{ ai_gen_id }}__headline { font-size: 32px; }
    .ai-our-story-{{ ai_gen_id }}__media,
    .ai-our-story-{{ ai_gen_id }}__image,
    .ai-our-story-{{ ai_gen_id }}__placeholder,
    .ai-our-story-{{ ai_gen_id }}__placeholder svg { min-height: 260px; }
  }
{% endstyle %}

<div class="ai-our-story-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-our-story-{{ ai_gen_id }}__bar">{{ block.settings.header_title | escape }}</div>
  <div class="ai-our-story-{{ ai_gen_id }}__layout">
    <div class="ai-our-story-{{ ai_gen_id }}__copy">
      {% if block.settings.headline != blank %}
        <h2 class="ai-our-story-{{ ai_gen_id }}__headline">{{ block.settings.headline | newline_to_br }}</h2>
      {% endif %}
      {% if block.settings.body_text != blank %}
        <div class="ai-our-story-{{ ai_gen_id }}__body">
          {{ block.settings.body_text }}

          {% if block.settings.cta_url != blank %}
            <a class="ai-our-story-{{ ai_gen_id }}__button" href="{{ block.settings.cta_url }}" target="_blank">{{ block.settings.cta_text }}</a>
          {% endif %}

        </div>
      {% endif %}
    </div>
    <div class="ai-our-story-{{ ai_gen_id }}__media">
      {% if block.settings.image != blank %}
        <img class="ai-our-story-{{ ai_gen_id }}__image" src="{{ block.settings.image | image_url: width: 1600 }}" alt="{{ block.settings.image.alt | escape }}" loading="lazy" width="{{ block.settings.image.width }}" height="{{ block.settings.image.height }}">
      {% comment %} {% else %}
        <div class="ai-our-story-{{ ai_gen_id }}__placeholder">
          {{ 'image' | placeholder_svg_tag }}
          <div class="ai-our-story-{{ ai_gen_id }}__empty-state">Add an image to tell your brand story.</div>
        </div> {% endcomment %}
      {% endif %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Our story article",
  "settings": [
    { "type": "header", "content": "Block Settings" },
    { "type": "text", "id": "block_padding", "label": "Block", "default": "25px 25px 30px" },
    { "type": "range", "id": "layout_gap", "label": "Content gap","min":1, "max": 60, "step": 1, "unit": "px", "default": 28 },
    { "type": "header", "content": "Header bar" },
    { "type": "text", "id": "header_title", "label": "Title", "default": "OUR STORY" },
    { "type": "color", "id": "header_background_color", "label": "Background", "default": "#06149B" },
    { "type": "color", "id": "header_text_color", "label": "Text", "default": "#FFFFFF" },
    { "type": "header", "content": "Content" },
    { "type": "range", "id": "copy_width", "label": "Content width", "min": 10, "max": 100, "step": 5, "unit": "%", "default": 60 },
    { "type": "text", "id": "headline", "label": "Headline", "default": "More than a destination. \n A reason to get out and ride." },
    { "type": "select", "id": "headline_style", "label": "Headline style", "options": [{ "value": "lowercase", "label": "Lowercase" }, { "value": "capitalize", "label": "Capitalize" }, { "value": "uppercase", "label": "Uppercase" }], "default": "uppercase" },
    { "type": "color", "id": "headline_color", "label": "Headline color", "default": "#06149B" },
    { "type": "range", "id": "headline_size", "label": "Headline font size", "min": 10, "max": 50, "step": 2, "unit": "px", "default": 32 },
    { "type": "richtext", "id": "body_text", "label": "Body text", "default": "<p>We believe every ride is a chance to go further. Our cycling essentials are made for the miles, the moments, and the people who make the journey worth it.</p><p>Designed with purpose and built to move, we bring performance-minded style to every adventure.</p>" },
    { "type": "range", "id": "body_size", "label": "Body font size", "min": 10, "max": 50, "step": 1, "unit": "px", "default": 16 },
    { "type": "range", "id": "media_width", "label": "Media width", "min": 10, "max": 100, "step": 5, "unit": "%", "default": 40 },
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "select", "id": "image_position", "label": "Image position", "options": [{ "value": "right", "label": "Right" }, { "value": "left", "label": "Left" }], "default": "right" },
    { "type": "header", "content": "Colors and layout" },
    { "type": "color", "id": "background_color", "label": "Background", "default": "#FFFFFF" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#151515" },
    { "type": "range", "id": "cta_size", "label": "CTA font size", "min": 10, "max": 50, "step": 1, "unit": "px", "default": 14 },
    { "type": "text", "id": "cta_text", "label": "CTA text" },
    { "type": "url", "id": "cta_url", "label": "CTA URL" },
    { "type": "color", "id": "cta_background_color", "label": "CTA Background", "default": "#06149B" },
    { "type": "color", "id": "cta_text_color", "label": "CTA color", "default": "#FFFFFF" },
    { "type": "text", "id": "cta_padding", "label": "CTA Padding", "default": "6px 30px" },
    { "type": "range", "id": "desktop_width_percent", "label": "Desktop width", "min": 50, "max": 100, "step": 5, "unit": "%", "default": 100 }
  ],
  "presets": [{ "name": "Our story article" }],
  "tag": null,
  "class": "our-story-article"
}
{% endschema %}