{% doc %}
  @prompt
    Create a page banner block with: 1) A small navy header bar at the top with editable title text (e.g. " ABOUT STRADE & THE POPO! ") in pixel/monospace font style, 2) A full-width hero image below the header bar, 3) A navy blue overlay bar at the bottom of the image with a bold centered headline and a smaller subtitle text below it. Settings: header background color, header text color, hero image picker, headline text, subtitle text, headline font size, overlay background color, overlay text color. Clean minimal design matching cycling apparel aesthetic
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-page-banner-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    overflow: hidden;
  }

  .ai-page-banner-{{ ai_gen_id }}__header {
    display: flex;
    align-items: center;
    justify-content: flex-start;
    min-height: 38px;
    padding: 8px 16px;
    background: {{ block.settings.header_background }};
    color: {{ block.settings.header_text_color }};
    font-size: {{ block.settings.header_size }}px;
    font-family: 'ChiKareGo2';
    font-weight: 500;
    letter-spacing: 0;
    line-height: 1.3;
    text-align: left;
    text-transform: uppercase;
  }

  .ai-page-banner-{{ ai_gen_id }}__media {
    position: relative;
    width: 100%;
    line-height: 0;
  }

  .ai-page-banner-{{ ai_gen_id }}__image {
    display: block;
    width: 100%;
    height: auto;
    min-height: 340px;
    max-height: 680px;
    object-fit: cover;
    object-position: center;
  }

  .ai-page-banner-{{ ai_gen_id }}__placeholder {
    display: flex;
    position: relative;
    align-items: center;
    justify-content: center;
    width: 100%;
    min-height: 320px;
    background: #e8ebef;
    line-height: normal;
  }

  .ai-page-banner-{{ ai_gen_id }}__placeholder svg {
    display: block;
    width: 100%;
    height: 100%;
    min-height: 320px;
    max-height: 520px;
    color: #6b7480;
  }

  .ai-page-banner-{{ ai_gen_id }}__empty-state {
    position: absolute;
    bottom: 18px;
    left: 50%;
    width: max-content;
    max-width: calc(100% - 32px);
    padding: 8px 12px;
    transform: translateX(-50%);
    background: #ffffff;
    color: #202833;
    font-size: 12px;
    line-height: 1.4;
    text-align: center;
  }

  .ai-page-banner-{{ ai_gen_id }}__overlay {
    position: absolute;
    right: 0;
    bottom: 0;
    left: 0;
    padding: 22px 20px 24px;
    background: {{ block.settings.overlay_background }};
    color: {{ block.settings.overlay_text_color }};
    text-align: center;
    line-height: normal;
  }

  .ai-page-banner-{{ ai_gen_id }}__headline {
    margin: 0;
    color: inherit;
    font-size: {{ block.settings.headline_size }}px;
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: 0.01em;
  }

  .ai-page-banner-{{ ai_gen_id }}__subtitle {
    margin: 8px 0 0;
    color: inherit;
    font-size: {{ block.settings.subtitle_size }}px;
    line-height: 1.5;
  }

  @media screen and (max-width: 749px) {
    .ai-page-banner-{{ ai_gen_id }}__header {
      min-height: 34px;
      padding: 7px 12px;
      font-size: 11px;
    }

    .ai-page-banner-{{ ai_gen_id }}__image {
      min-height: 230px;
      max-height: 520px;
    }

    .ai-page-banner-{{ ai_gen_id }}__overlay {
      padding: 16px 14px 18px;
    }

    .ai-page-banner-{{ ai_gen_id }}__headline {
      font-size: min({{ block.settings.headline_size }}px, 8vw);
    }

    .ai-page-banner-{{ ai_gen_id }}__subtitle {
      margin-top: 6px;
      font-size: 12px;
    }
  }
{% endstyle %}

<div class="ai-page-banner-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-page-banner-{{ ai_gen_id }}__header">{{ block.settings.header_title | escape }}</div>
  <div class="ai-page-banner-{{ ai_gen_id }}__media">
    {% if block.settings.hero_image != blank %}
      <img
        class="ai-page-banner-{{ ai_gen_id }}__image"
        src="{{ block.settings.hero_image | image_url: width: 2400 }}"
        alt="{{ block.settings.hero_image.alt | escape }}"
        width="{{ block.settings.hero_image.width }}"
        height="{{ block.settings.hero_image.height }}"
        loading="lazy"
      >
    {% else %}
      <div class="ai-page-banner-{{ ai_gen_id }}__placeholder">
        {{ 'hero-apparel-1' | placeholder_svg_tag }}
        <div class="ai-page-banner-{{ ai_gen_id }}__empty-state">Add a hero image in the block settings</div>
      </div>
    {% endif %}
    <div class="ai-page-banner-{{ ai_gen_id }}__overlay">
      {% if block.settings.headline != blank %}
        <h1 class="ai-page-banner-{{ ai_gen_id }}__headline">{{ block.settings.headline | escape }}</h1>
      {% endif %}
      {% if block.settings.subtitle != blank %}
        <p class="ai-page-banner-{{ ai_gen_id }}__subtitle">{{ block.settings.subtitle | escape }}</p>
      {% endif %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Page banner",
  "settings": [
    {
      "type": "header",
      "content": "Header bar"
    },
    {
      "type": "text",
      "id": "header_title",
      "label": "Header title",
      "default": "ABOUT STRADE & THE POPO!"
    },
     {
      "type": "range",
      "id": "header_size",
      "label": "Header font size",
      "min": 12,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 15
    },
    {
      "type": "color",
      "id": "header_background",
      "label": "Background",
      "default": "#101F3A"
    },
    {
      "type": "color",
      "id": "header_text_color",
      "label": "Text color",
      "default": "#FFFFFF"
    },
    {
      "type": "header",
      "content": "Hero image"
    },
    {
      "type": "image_picker",
      "id": "hero_image",
      "label": "Image"
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "header",
      "content": "Image caption"
    },
    {
      "type": "text",
      "id": "headline",
      "label": "Headline",
      "default": "BUILT FOR THE RIDE"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Performance cycling apparel for every journey."
    },
    {
      "type": "range",
      "id": "headline_size",
      "label": "Headline font size",
      "min": 18,
      "max": 48,
      "step": 2,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "subtitle_size",
      "label": "Subtitle font size",
      "min": 12,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 20
    },
    {
      "type": "color",
      "id": "overlay_background",
      "label": "Overlay background",
      "default": "#101F3A"
    },
    {
      "type": "color",
      "id": "overlay_text_color",
      "label": "Overlay text color",
      "default": "#FFFFFF"
    }
  ],
  "presets": [
    {
      "name": "Page banner"
    }
  ],
  "tag": null,
  "class": "page-banner-block"
}
{% endschema %}