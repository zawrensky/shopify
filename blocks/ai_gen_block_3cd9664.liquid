{% doc %}
  @prompt
    Create a custom "Brands We Love" section block with the following features:
    
    Header: Editable section title (default: " BRANDS WE LOVE ") with customizable text color, background color (default: dark navy/blue), font size, and text alignment.
    
    Brand Logo Grid: A responsive grid layout displaying brand logos with:
    
    Dynamic image picker blocks — merchant can add/remove brand logos freely (no hard-coded limit)
    Each brand block has: an image_picker for the logo, an optional link URL, and an optional alt text field
    Logos displayed in a multi-column responsive grid (3 columns desktop, 2 columns tablet, 2 columns mobile)
    Each logo image is centered vertically and horizontally within its cell
    Consistent logo height (60px) with object-fit: contain so logos aren't distorted
    Section settings: background color (default white), padding top/bottom, max-width container, and thin navy border outline around the entire section.
    
    Schema: Use block type with type: "brand_item", settings for image, link, and alt. The section should support up to 20 brand blocks dynamically added by the merchant.
    
    , tambahkan pengaturan horizontal padding pada section layout, tambahkan pengaturan alignmment logo, dan jarak antar logo, atur posisi logo - logo rata tengah/kiri/kanan sesuai pengaturan alignment (default tengah), display logo flexbox rata tengah horizontal
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}
{% style %}
  .ai-brands-{{ ai_gen_id }} { display:block; width:100%; max-width:{{ block.settings.max_width }}px; margin-inline:auto; background:{{ block.settings.section_background }}; border:1px solid {{ block.settings.border_color }}; padding:{{ block.settings.padding_vertical }}px {{ block.settings.padding_horizontal }}px; box-sizing:border-box; }
  .ai-brands-{{ ai_gen_id }}__heading { width:100%; margin:0 0 16px; padding:0 18px; background:{{ block.settings.header_background }}; color:{{ block.settings.header_text_color }}; font-size:{{ block.settings.heading_size }}px; font-weight:500; line-height:40px; text-align:{{ block.settings.heading_alignment }}; letter-spacing:.08em; box-sizing:border-box; }
  .ai-brands-{{ ai_gen_id }}__grid { display:flex; flex-direction: row; flex-wrap: wrap; gap:{{ block.settings.logo_gap }}px; justify-content: {{ block.settings.logo_alignment}}; }
  .ai-brands-{{ ai_gen_id }}__item { min-width:30%; display:flex; align-items:center; justify-content:center; box-sizing:border-box; }
  .ai-brands-{{ ai_gen_id }}__item a { display:flex; width:100%; height:100%; min-height:64px; align-items:center; justify-content:center; }
  .ai-brands-{{ ai_gen_id }}__logo { display:block; width:auto; max-width:100%; height:60px; object-fit:contain; }
  .ai-brands-{{ ai_gen_id }}__empty { margin:8px 0 0; color:#555555; font-size:13px; text-align:center; }
  @media screen and (max-width:989px) { .ai-brands-{{ ai_gen_id }}__grid { grid-template-columns:repeat(2,minmax(0,1fr)); } }
{% endstyle %}
<div class="ai-brands-{{ ai_gen_id }}" style="width:{{ block.settings.desktop_width_percent }}%;" {{ block.shopify_attributes }}>
{% if block.settings.heading != blank %}<h2 class="ai-brands-{{ ai_gen_id }}__heading">{{ block.settings.heading | escape }}</h2>{% endif %}
<div class="ai-brands-{{ ai_gen_id }}__grid">
{% for i in (1..20) %}
{% liquid
assign image_key = 'brand_image_' | append: i
assign link_key = 'brand_link_' | append: i
assign alt_key = 'brand_alt_' | append: i
assign brand_image = block.settings[image_key]
assign brand_link = block.settings[link_key]
assign brand_alt = block.settings[alt_key]
%}
{% if brand_image != blank %}<div class="ai-brands-{{ ai_gen_id }}__item">{% if brand_link != blank %}<a href="{{ brand_link }}" aria-label="{{ brand_alt | default: brand_image.alt | escape }}">{% endif %}<img class="ai-brands-{{ ai_gen_id }}__logo" src="{{ brand_image | image_url: width: 500 }}" alt="{{ brand_alt | default: brand_image.alt | escape }}" loading="lazy" width="{{ brand_image.width }}" height="{{ brand_image.height }}">{% if brand_link != blank %}</a>{% endif %}</div>{% endif %}
{% endfor %}
</div>
{% assign any_brand = false %}{% for i in (1..20) %}{% assign image_key = 'brand_image_' | append: i %}{% if block.settings[image_key] != blank %}{% assign any_brand = true %}{% endif %}{% endfor %}
{% unless any_brand %}<p class="ai-brands-{{ ai_gen_id }}__empty">Add brand logos in the block settings to populate this grid.</p>{% endunless %}
</div>
