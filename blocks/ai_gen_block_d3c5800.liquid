{% doc %}
  @prompt
    reate a product categories block in retro/pixel style. It should have: a dark blue header bar with " CATEGORIES " text in bold monospace font centered, followed by a white background list of category links. Each category item has a red filled circle bullet point on the left, followed by the collection name as a dark blue underlined link in monospace font. Each item should have a thin bottom border separator. The overall widget has a border and compact styling. IMPORTANT: Load the categories dynamically using Liquid by looping through Shopify collections (collections object) so all published collections appear automatically as links pointing to their collection URLs. Do not hardcode category names — use {{ collection.title }} and {{ collection.url }} from a for loop over collections.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-category-widget-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    border: {{ block.settings.border_width }}px solid {{ block.settings.border_color }};
    background: {{ block.settings.list_background }};
    color: {{ block.settings.link_color }};
  }

  .ai-category-widget-{{ ai_gen_id }}__header {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 42px;
    padding: 8px 12px;
    background: {{ block.settings.header_background }};
    color: {{ block.settings.header_text_color }};
    font-size: {{ block.settings.header_size }}px;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-align: center;
  }

  .ai-category-widget-{{ ai_gen_id }}__list {
    margin: 0;
    padding: 0 14px;
    list-style: none;
  }

  .ai-category-widget-{{ ai_gen_id }}__item {
    display: flex;
    align-items: center;
    gap: 10px;
    min-height: 40px;
    border-bottom: 1px solid {{ block.settings.separator_color }};
  }

  .ai-category-widget-{{ ai_gen_id }}__item:last-child {
    border-bottom: 0;
  }

  .ai-category-widget-{{ ai_gen_id }}__bullet {
    width: 9px;
    height: 9px;
    flex: 0 0 9px;
    border-radius: 50%;
    background: {{ block.settings.bullet_color }};
  }

  .ai-category-widget-{{ ai_gen_id }}__link {
    display: block;
    flex: 1;
    padding: 9px 0;
    color: {{ block.settings.link_color }};
    font-size: {{ block.settings.link_size }}px;
    font-weight: 700;
    line-height: 1.3;
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .ai-category-widget-{{ ai_gen_id }}__link:hover,
  .ai-category-widget-{{ ai_gen_id }}__link:focus-visible {
    color: {{ block.settings.link_hover_color }};
  }

  .ai-category-widget-{{ ai_gen_id }}__empty {
    padding: 14px;
    color: {{ block.settings.link_color }};
    font-size: {{ block.settings.link_size }}px;
  }

  @media screen and (max-width: 749px) {
    .ai-category-widget-{{ ai_gen_id }} {
      width: 100%;
    }
  }
{% endstyle %}

<div class="ai-category-widget-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-category-widget-{{ ai_gen_id }}__header">== CATEGORIES ==</div>
  {% if collections.size > 0 %}
    <ul class="ai-category-widget-{{ ai_gen_id }}__list" role="list">
      {% for collection in collections %}
        <li class="ai-category-widget-{{ ai_gen_id }}__item">
          <span class="ai-category-widget-{{ ai_gen_id }}__bullet" aria-hidden="true"></span>
          <a class="ai-category-widget-{{ ai_gen_id }}__link" href="{{ collection.url }}">{{ collection.title | escape }}</a>
        </li>
      {% endfor %}
    </ul>
  {% else %}
    <div class="ai-category-widget-{{ ai_gen_id }}__empty">No categories available.</div>
  {% endif %}
</div>

{% schema %}
{
  "name": "Product categories",
  "settings": [
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "header_background",
      "label": "Header background",
      "default": "#102A43"
    },
    {
      "type": "color",
      "id": "header_text_color",
      "label": "Header text",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "list_background",
      "label": "List background",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "link_color",
      "label": "Link text",
      "default": "#102A43"
    },
    {
      "type": "color",
      "id": "link_hover_color",
      "label": "Link hover text",
      "default": "#C62828"
    },
    {
      "type": "color",
      "id": "bullet_color",
      "label": "Bullet",
      "default": "#C62828"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border",
      "default": "#102A43"
    },
    {
      "type": "color",
      "id": "separator_color",
      "label": "Separators",
      "default": "#D9E2EC"
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "header_size",
      "label": "Header size",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "link_size",
      "label": "Link size",
      "min": 12,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "range",
      "id": "border_width",
      "label": "Border width",
      "min": 1,
      "max": 4,
      "step": 1,
      "unit": "px",
      "default": 1
    }
  ],
  "presets": [
    {
      "name": "Product categories"
    }
  ],
  "tag": null,
  "class": "product-categories-block"
}
{% endschema %}