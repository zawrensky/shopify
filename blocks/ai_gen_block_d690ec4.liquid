{% doc %}
  @prompt
    Create a custom product grid block with the following features:
    
    HEADER BAR:
    
    Bold uppercase title text on the left (e.g. " NEW ARRIVALS ") and a "VIEW ALL >>" link on the right
    Schema settings: header background color, header text color, header link text and URL
    PRODUCT GRID:
    
    Product cards showing: product image, product title (bold, centered), and price (centered)
    Desktop: 5 columns (adjustable 2-6 via schema setting)
    Mobile: 2 columns (adjustable 1-3 via schema setting)
    Collection source selectable via schema
    SCHEMA COLOR SETTINGS (all adjustable in Theme Editor):
    
    Section background color
    Section border color and width
    Header background color
    Header text color
    Header "View All" link color
    Product card background color
    Product card border color
    Product title color
    Product price color
    SCHEMA OTHER SETTINGS:
    
    Heading text
    "View All" link URL (collection link)
    Desktop columns (range 2-6, default 5)
    Mobile columns (range 1-3, default 2)
    Collection to pull products from
    Number of products to show
    Clean sports store aesthetic. All colors must be individually configurable from the Theme Editor sidebar., add border between product image and product title, add space between product card, font setting for heading and view all text, add font size in heading and view all
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}
{% style %}.ai-product-grid-{{ ai_gen_id }}{display:block;width:{{ block.settings.desktop_width_percent }}%;max-width:100%;background:{{ block.settings.section_background }};border:{{ block.settings.section_border_width }}px solid {{ block.settings.section_border_color }}}.ai-product-grid-{{ ai_gen_id }}__header{display:flex;align-items:center;justify-content:space-between;gap:20px;padding:0 18px;background:{{ block.settings.header_background }};color:{{ block.settings.header_text_color }}}.ai-product-grid-{{ ai_gen_id }}__heading{margin:0;font-size:{{ block.settings.heading_size }}px;line-height:40px;font-family: "ChiKareGo2";font-weight:500;letter-spacing:.08em;text-transform:uppercase}.ai-product-grid-{{ ai_gen_id }}__link{flex-shrink:0;color:{{ block.settings.header_link_color }};font-family: "ChiKareGo2";font-size:{{ block.settings.link_size }}px;font-weight:500;letter-spacing:.05em;text-decoration:none}.ai-product-grid-{{ ai_gen_id }}__link:focus-visible,.ai-product-grid-{{ ai_gen_id }}__card:focus-visible{outline:3px solid currentColor;outline-offset:3px}.ai-product-grid-{{ ai_gen_id }}__items{display:grid;grid-template-columns:repeat({{ block.settings.desktop_columns }},minmax(0,1fr));gap:{{ block.settings.card_gap }}px;background:{{ block.settings.section_background }};padding:{{ block.settings.card_gap }}px}.ai-product-grid-{{ ai_gen_id }}__card{display:block;min-width:0;padding:0 0 12px;background:{{ block.settings.card_background }};color:inherit;text-decoration:none;border:1px solid {{ block.settings.card_border_color }}}.ai-product-grid-{{ ai_gen_id }}__image-wrap{aspect-ratio:1/1;overflow:hidden;background:{{ block.settings.section_background }};border-bottom:1px solid {{ block.settings.card_border_color }}}.ai-product-grid-{{ ai_gen_id }}__image-wrap img,.ai-product-grid-{{ ai_gen_id }}__placeholder svg{display:block;width:100%;height:100%;object-fit:cover}.ai-product-grid-{{ ai_gen_id }}__placeholder{width:100%;height:100%}.ai-product-grid-{{ ai_gen_id }}__title{margin:0;padding:12px 10px 5px;color:{{ block.settings.product_title_color }};font-size:14px;line-height:1.35;font-weight:700;text-align:center}.ai-product-grid-{{ ai_gen_id }}__price{margin:0;color:{{ block.settings.product_price_color }};font-size:14px;line-height:1.35;text-align:center}.ai-product-grid-{{ ai_gen_id }}__empty{grid-column:1/-1;padding:32px 20px;color:{{ block.settings.product_title_color }};text-align:center}@media screen and (max-width:749px){.ai-product-grid-{{ ai_gen_id }}__header{padding:14px 15px}.ai-product-grid-{{ ai_gen_id }}__heading{font-size:{{ block.settings.heading_size_mobile }}px}.ai-product-grid-{{ ai_gen_id }}__link{font-size:{{ block.settings.link_size_mobile }}px}.ai-product-grid-{{ ai_gen_id }}__items{grid-template-columns:repeat({{ block.settings.mobile_columns }},minmax(0,1fr))}.ai-product-grid-{{ ai_gen_id }}__card{padding:8px}.ai-product-grid-{{ ai_gen_id }}__title,.ai-product-grid-{{ ai_gen_id }}__price{font-size:12px}}{% endstyle %}
<div class="ai-product-grid-{{ ai_gen_id }}" {{ block.shopify_attributes }}><div class="ai-product-grid-{{ ai_gen_id }}__header"><h2 class="ai-product-grid-{{ ai_gen_id }}__heading">{{ block.settings.heading | escape }}</h2>{% if block.settings.view_all_url != blank %}<a class="ai-product-grid-{{ ai_gen_id }}__link" href="{{ block.settings.view_all_url }}">{{ block.settings.view_all_text | escape }}</a>{% endif %}</div><div class="ai-product-grid-{{ ai_gen_id }}__items">{% if block.settings.collection != blank %}{% for product in block.settings.collection.products limit: block.settings.product_limit %}<a class="ai-product-grid-{{ ai_gen_id }}__card" href="{{ product.url }}" aria-label="{{ product.title | escape }}"><div class="ai-product-grid-{{ ai_gen_id }}__image-wrap">{% if product.featured_image %}<img src="{{ product.featured_image | image_url: width: 800 }}" alt="{{ product.featured_image.alt | default: product.title | escape }}" loading="lazy" width="800" height="800">{% else %}<div class="ai-product-grid-{{ ai_gen_id }}__placeholder">{{ 'product-apparel-1' | placeholder_svg_tag }}</div>{% endif %}</div><h3 class="ai-product-grid-{{ ai_gen_id }}__title">{{ product.title | escape }}</h3><p class="ai-product-grid-{{ ai_gen_id }}__price">{{ product.price | money }}</p></a>{% else %}<p class="ai-product-grid-{{ ai_gen_id }}__empty">No products are available in this collection.</p>{% endfor %}{% else %}<p class="ai-product-grid-{{ ai_gen_id }}__empty">Select a collection to display products.</p>{% endif %}</div></div>
{% schema %}{"name":"Custom product grid","tag":null,"class":"custom-product-grid-block","settings":[{"type":"header","content":"Content"},{"type":"text","id":"heading","label":"Heading","default":"NEW ARRIVALS"},{"type":"font_picker","id":"heading_font","label":"Heading font","default":"mono"},{"type":"range","id":"heading_size","label":"Heading size","min":12,"max":48,"step":1,"unit":"px","default":18},{"type":"range","id":"heading_size_mobile","label":"Heading size on mobile","min":10,"max":32,"step":1,"unit":"px","default":15},{"type":"text","id":"view_all_text","label":"View all text","default":"VIEW ALL >>"},{"type":"font_picker","id":"link_font","label":"View all font","default":"mono"},{"type":"range","id":"link_size","label":"View all size","min":10,"max":32,"step":1,"unit":"px","default":13},{"type":"range","id":"link_size_mobile","label":"View all size on mobile","min":9,"max":24,"step":1,"unit":"px","default":11},{"type":"url","id":"view_all_url","label":"View all link"},{"type":"collection","id":"collection","label":"Collection"},{"type":"range","id":"product_limit","label":"Products to show","min":2,"max":24,"step":1,"default":10},{"type":"header","content":"Layout"},{"type":"range","id":"desktop_width_percent","label":"Desktop width","min":50,"max":100,"step":5,"unit":"%","default":100},{"type":"range","id":"desktop_columns","label":"Desktop columns","min":2,"max":6,"step":1,"default":5},{"type":"range","id":"mobile_columns","label":"Mobile columns","min":1,"max":3,"step":1,"default":2},{"type":"range","id":"card_gap","label":"Space between cards","min":0,"max":32,"step":2,"unit":"px","default":8},{"type":"header","content":"Colors"},{"type":"color","id":"section_background","label":"Section background","default":"#ffffff"},{"type":"color","id":"section_border_color","label":"Section border","default":"#000000"},{"type":"range","id":"section_border_width","label":"Border width","min":0,"max":8,"step":1,"unit":"px","default":1},{"type":"color","id":"header_background","label":"Header background","default":"#000000"},{"type":"color","id":"header_text_color","label":"Header text","default":"#ffffff"},{"type":"color","id":"header_link_color","label":"Header link","default":"#ffffff"},{"type":"color","id":"card_background","label":"Card background","default":"#ffffff"},{"type":"color","id":"card_border_color","label":"Card border","default":"#dfdfdf"},{"type":"color","id":"product_title_color","label":"Product title","default":"#000000"},{"type":"color","id":"product_price_color","label":"Product price","default":"#333333"}],"presets":[{"name":"Custom product grid"}]}{% endschema %}