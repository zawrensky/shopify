{% doc %}
  @prompt
    buat news block dengan fiture sebagai berikut:
    HEADER BAR (full-width, di bagian atas block):
    
    Kiri: teks judul bold uppercase (contoh: " FROM THE JOURNAL ")
    Kanan: link "VIEW ALL >>" dengan URL yang bisa dikonfigurasi
    Header bar dengan background navy blue solid
    Schema settings: header title text, header title color, header background color, "View All" link text, "View All" link URL, "View All" link color
    BLOG POST GRID:
    
    Mengambil artikel otomatis dari blog yang dipilih (blog_handle schema setting)
    Menampilkan artikel sebagai kartu dalam grid responsif
    Desktop: 3 kolom (dapat diatur 2-4 via schema)
    Mobile: 1 kolom
    Jumlah artikel yang ditampilkan: bisa dikonfigurasi (default 3, max 9)
    SETIAP KARTU ARTIKEL:
    
    Gambar featured article di bagian atas (lebar penuh kartu, tinggi tetap ~180px, object-fit cover)
    Judul artikel di bawah gambar (bold, warna biru gelap, bisa dikonfigurasi)
    Link "» Read More" di bawah judul (teks, warna, dan link menuju URL artikel bisa dikonfigurasi)
    Background kartu putih dengan border tipis
    Tidak menampilkan author atau tanggal — hanya gambar, judul, dan link read more
    SCHEMA COLOR/STYLE SETTINGS:
    
    Header background color
    Header text color
    "View All" link color
    Card background color
    Card border color
    Article title color
    "Read More" link color
    Card image height (range 120-300px, default 180)
    Desktop columns (range 2-4, default 3)
    Number of articles (range 1-9, default 3)
    Blog source (blog_handle picker)
    "Read More" link text (default "» Read More")
    Tampilan bersih bergaya toko olahraga/cycling. Kartu tersusun rapi dalam grid dengan jarak yang konsisten, tambahkan pengaturan jarak antar berita
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}
{% assign news_blog = block.settings.blog_source %}

{% style %}
  .ai-news-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    color: #17243a;
    border: 1px solid  #8588B0;
  }

  .ai-news-{{ ai_gen_id }}__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 0 18px;
    background: {{ block.settings.header_background }};
  }

  .ai-news-{{ ai_gen_id }}__heading {
    margin: 0;
    color: {{ block.settings.header_text_color }};
    font-size: 22px;
    line-height: 40px;
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .ai-news-{{ ai_gen_id }}__all-link {
    flex: 0 0 auto;
    color: {{ block.settings.view_all_color }};
    font-family: "ChiKareGo2";
    font-size: 18px;
    font-weight: 500;
    text-decoration: none;
    text-underline-offset: 3px;
  }

  .ai-news-{{ ai_gen_id }}__all-link:focus-visible,
  .ai-news-{{ ai_gen_id }}__read-link:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 3px;
  }

  .ai-news-{{ ai_gen_id }}__grid {
    display: grid;
    grid-template-columns: repeat({{ block.settings.desktop_columns }}, minmax(0, 1fr));
    gap: {{ block.settings.article_gap }}px;
    padding: 6px;
  }

  .ai-news-{{ ai_gen_id }}__card {
    min-width: 0;
    overflow: hidden;
    background: {{ block.settings.card_background }};
    border: 1px solid {{ block.settings.card_border }};
    display: flex;
    flex-direction: column;
  }

  .ai-news-{{ ai_gen_id }}__media {
    display: block;
    height: {{ block.settings.image_height }}px;
    overflow: hidden;
    background: #eef1f5;
  }

  .ai-news-{{ ai_gen_id }}__media img,
  .ai-news-{{ ai_gen_id }}__media svg {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-news-{{ ai_gen_id }}__media svg {
    background: #eef1f5;
    color: #65738a;
  }

  .ai-news-{{ ai_gen_id }}__body {
    display: flex;
    flex: 1;
    flex-direction: column;
    align-items: flex-start;
    justify-content: space-between;
    gap: 8px;
    padding: 10px;
  }

  .ai-news-{{ ai_gen_id }}__title {
    margin: 0;
    color: {{ block.settings.article_title_color }};
    font-size: {{ block.settings.article_title_fontsize }}px;
    line-height: 1.35;
    font-weight: 700;
  }

  .ai-news-{{ ai_gen_id }}__read-link {
    margin-top: 0;
    color: {{ block.settings.read_more_color }};
    font-size: {{ block.settings.read_more_fontsize }}px;
    font-weight: 700;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .ai-news-{{ ai_gen_id }}__empty {
    padding: 24px 16px;
    color: #4b5563;
    font-size: 14px;
    text-align: center;
    border: 1px dashed #9ca3af;
  }

  @media screen and (max-width: 749px) {
    .ai-news-{{ ai_gen_id }} {
      width: 100%;
    }

    .ai-news-{{ ai_gen_id }}__grid {
      grid-template-columns: 1fr;
    }
  }
{% endstyle %}

<div class="ai-news-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-news-{{ ai_gen_id }}__header">
    <h2 class="ai-news-{{ ai_gen_id }}__heading">{{ block.settings.header_title | escape }}</h2>
    {% if block.settings.view_all_url != blank %}
      <a class="ai-news-{{ ai_gen_id }}__all-link" href="{{ block.settings.view_all_url }}">{{ block.settings.view_all_text | escape }}</a>
    {% else %}
      <span class="ai-news-{{ ai_gen_id }}__all-link">{{ block.settings.view_all_text | escape }}</span>
    {% endif %}
  </div>

  {% if news_blog != blank and news_blog.articles_count > 0 %}
    <div class="ai-news-{{ ai_gen_id }}__grid">
      {% for article in news_blog.articles limit: block.settings.article_count %}
        <article class="ai-news-{{ ai_gen_id }}__card">
          <a class="ai-news-{{ ai_gen_id }}__media" href="{{ article.url }}" aria-label="{{ article.title | escape }}">
            {% if article.image %}
              <img src="{{ article.image | image_url: width: 1000 }}" alt="{{ article.image.alt | default: article.title | escape }}" loading="lazy" width="{{ article.image.width }}" height="{{ article.image.height }}">
            {% else %}
              <div class="ai-news-{{ ai_gen_id }}__media-placeholder">{{ 'blog-apparel-1' | placeholder_svg_tag }}</div>
            {% endif %}
          </a>
          <div class="ai-news-{{ ai_gen_id }}__body">
            <h3 class="ai-news-{{ ai_gen_id }}__title">{{ article.title | escape }}</h3>
            <a class="ai-news-{{ ai_gen_id }}__read-link" href="{{ article.url }}">{{ block.settings.read_more_text | escape }}</a>
          </div>
        </article>
      {% endfor %}
    </div>
  {% else %}
    <div class="ai-news-{{ ai_gen_id }}__empty">Pilih blog yang berisi artikel untuk menampilkan berita di sini.</div>
  {% endif %}
</div>

{% schema %}
{
  "name": "News article grid",
  "settings": [
    { "type": "header", "content": "Header bar" },
    { "type": "text", "id": "header_title", "label": "Header title", "default": "FROM THE JOURNAL" },
    { "type": "color", "id": "header_background", "label": "Background", "default": "#102A4C" },
    { "type": "color", "id": "header_text_color", "label": "Title color", "default": "#FFFFFF" },
    { "type": "text", "id": "view_all_text", "label": "View all text", "default": "VIEW ALL >>" },
    { "type": "url", "id": "view_all_url", "label": "View all link" },
    { "type": "color", "id": "view_all_color", "label": "View all color", "default": "#FFFFFF" },
    { "type": "header", "content": "Articles" },
    { "type": "blog", "id": "blog_source", "label": "Blog source" },
    { "type": "range", "id": "article_count", "label": "Number of articles", "min": 1, "max": 9, "step": 1, "default": 3 },
    { "type": "range", "id": "desktop_columns", "label": "Desktop columns", "min": 2, "max": 4, "step": 1, "default": 3 },
    { "type": "range", "id": "image_height", "label": "Card image height", "min": 60, "max": 120, "step": 5, "unit": "px", "default": 90 },
    { "type": "range", "id": "article_gap", "label": "Article spacing", "min": 0, "max": 40, "step": 2, "unit": "px", "default": 18 },
    { "type": "text", "id": "read_more_text", "label": "Read more text", "default": "» Read More" },
    { "type": "range", "id": "read_more_fontsize", "label": "Read more font size", "min": 0, "max": 40, "step": 1, "unit": "px", "default": 12 },
    { "type": "header", "content": "Card style" },
    { "type": "color", "id": "card_background", "label": "Background", "default": "#FFFFFF" },
    { "type": "color", "id": "card_border", "label": "Border", "default": "#DFDFDF" },
    { "type": "color", "id": "article_title_color", "label": "Article title", "default": "#102A4C" },
    { "type": "range", "id": "article_title_fontsize", "label": "Title font size", "min": 0, "max": 40, "step": 1, "unit": "px", "default": 12 },
    { "type": "color", "id": "read_more_color", "label": "Read more link", "default": "#164E8A" },
    { "type": "range", "id": "desktop_width_percent", "label": "Desktop width", "min": 50, "max": 100, "step": 5, "unit": "%", "default": 100 }
  ],
  "presets": [
    { "name": "News article grid" }
  ],
  "tag": null,
  "class": "news-article-grid"
}
{% endschema %}